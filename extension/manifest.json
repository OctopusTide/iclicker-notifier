{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "version": "1.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "notifications", "offscreen"],
  "host_permissions": ["https://student.iclicker.com/*"],
  "background": {"service_worker": "service-worker.js"},
  "action": {"default_title": "__MSG_extensionName__", "default_popup": "popup.html", "default_icon": {"128": "icons/icon128.png"}},
  "icons": {"128": "icons/icon128.png"},
  "content_scripts": [{
    "matches": ["https://student.iclicker.com/*"],
    "js": ["detector.js", "content.js"],
    "run_at": "document_idle"
  }]
}
